{
  "watch_folder": "videos/inbox",
  "done_folder": "videos/done",
  "failed_folder": "videos/failed",
  "check_interval_seconds": 300,
  "file_stable_seconds": 10,
  "max_retries": 3,
  "video_extensions": [".mp4", ".mov", ".m4v", ".webm"],

  "browser": {
    "headless": false,
    "channel": "chrome",
    "profiles_dir": "browser_profiles",
    "slow_mo_ms": 150,
    "locale": "ko-KR"
  },

  "_계정설명": "운영 중인 채널(계정 그룹)을 여기에 등록하세요. 이름은 자유(예: 심리1, 요리, 운동). platforms에서 그룹별로 사용할 플랫폼을 켜고 끕니다. 영상을 올릴 그룹은 ① inbox 안에 그룹 이름 폴더를 만들어 영상을 넣거나 ② 사이드카 txt/json에 '계정: 심리2'를 적어 지정합니다. 지정이 없으면 default_account로 올라갑니다.",
  "default_account": "심리1",
  "accounts": {
    "심리1": {
      "description": "심리학 메인 채널",
      "platforms": {
        "facebook": true,
        "instagram": true,
        "tiktok": true,
        "naver_clip": false
      }
    },
    "심리2": {
      "description": "심리학 서브 채널 (짧은 명언 위주)",
      "platforms": {
        "facebook": true,
        "instagram": true,
        "tiktok": true,
        "naver_clip": false
      }
    }
  },

  "platform_settings": {
    "facebook": {
      "upload_timeout_seconds": 600
    },
    "instagram": {
      "upload_timeout_seconds": 600
    },
    "tiktok": {
      "upload_timeout_seconds": 600
    },
    "naver_clip": {
      "upload_timeout_seconds": 600,
      "_참고": "네이버 클립은 현재 PC 웹 업로드를 공식 지원하지 않습니다(모바일 앱 전용). 네이버가 PC 업로드를 열면 아래 URL과 셀렉터를 수정하고 accounts의 naver_clip을 true로 바꾸세요.",
      "upload_url": "https://m.blog.naver.com",
      "mobile_emulation": true,
      "selectors": {
        "file_input": ["input[type='file'][accept*='video']", "input[type='file']"],
        "title_input": ["input[placeholder*='제목']", "textarea[placeholder*='제목']"],
        "description_input": ["textarea[placeholder*='설명']", "div[contenteditable='true']"],
        "submit_button": ["button:has-text('올리기')", "button:has-text('등록')", "button:has-text('업로드')"]
      }
    }
  }
}
